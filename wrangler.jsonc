{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "games",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LUDO_ROOMS",
        "class_name": "LudoRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LudoRoom"]
    }
  ]
}
